<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur3_perception</name>
  <version>0.1.0</version>
  <description>
    YOLO-based object detection for the UR3e XR simulation pipeline.
    Subscribes to the D455 colour stream, runs YOLOv8 inference, and publishes
    detection results as JSON (std_msgs/String) for Unity consumption and an
    annotated debug image for RViz.
  </description>
  <maintainer email="jackfruittt@users.noreply.github.com">Jackson Russell</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rosbag2_py</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
